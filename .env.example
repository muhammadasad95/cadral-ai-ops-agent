# Copy to .env and fill in. Everything is optional except where noted; with no keys the app runs fully offline (mock LLM).

# --- LLM (free): https://console.groq.com/keys ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant

# --- Database: leave empty to use embedded PGlite; for production use Neon (free): postgres://...neon.tech/...?sslmode=require
DATABASE_URL=

# --- Security (required in production) ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@demo.shop
ADMIN_PASSWORD=admin123
AGENT_EMAIL=agent@demo.shop
AGENT_PASSWORD=agent123
PUBLIC_URL=http://localhost:7860

# --- Channels ---
TELEGRAM_BOT_TOKEN=
# Inbound email (IMAP) + outbound (SMTP or Brevo). For Gmail use an App Password, not your normal password.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
BREVO_API_KEY=

# --- Alerts and reports ---
SLACK_WEBHOOK_URL=
REPORT_EMAIL_TO=
REPORT_CRON=0 8 * * *
CRON_KEY=

# --- Behaviour ---
REVIEW_MODE=SMART
AUTO_REFUND_LIMIT_GBP=100
